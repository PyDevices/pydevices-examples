# Append to the ESP32-P4 panel's sdkconfig.board. A cache writeback
# (esp_cache_msync) runs with interrupts off; a display syncing hundreds of KB
# a frame held the USB interrupt off long enough to lose sound-card packets.
# Slicing it lets the interrupt in between.
CONFIG_ESP_MM_CACHE_MSYNC_C2M_CHUNKED_OPS=y
CONFIG_ESP_MM_CACHE_MSYNC_C2M_CHUNKED_OPS_MAX_LEN=0x2000
