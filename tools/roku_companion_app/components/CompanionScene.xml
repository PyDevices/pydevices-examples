<?xml version="1.0" encoding="utf-8" ?>
<component name="CompanionScene" extends="Scene">
    <script type="text/brightscript" uri="pkg:/components/CompanionScene.brs" />
    <interface>
        <field id="launchArgs" type="assocarray" onChange="onLaunchArgsChanged" />
        <!-- Set when the PyDevices app streaming frames has gone; Main closes the channel. -->
        <field id="exitChannel" type="boolean" alwaysNotify="true" />
    </interface>
    <children>
        <!-- Background -->
        <Rectangle id="background" width="1920" height="1080" color="0x1A1A1AFF">
            
            <!-- Dashboard / Status Text -->
            <Label id="statusLabel" text="PyDevices Companion Ready" horizAlign="center" vertAlign="center" width="1920" height="1080" wrap="true" font="font:LargeBoldSystemFont" color="0xFFFFFFFF" />
            
            <!-- Frames mode: still images (PNG or JPEG) fetched one after another from a URL, double buffered -->
            <Poster id="frameView1" width="1920" height="1080" visible="false" loadDisplayMode="scaleToFit" />
            <Poster id="frameView2" width="1920" height="1080" visible="false" loadDisplayMode="scaleToFit" />

            <!-- Video mode: H.264 (HLS, MP4, ...) from a URL -->
            <Video id="videoPlayer" width="1920" height="1080" visible="false" enableUI="false" />
            
        </Rectangle>
        
        <!-- Restarts frame fetching after a failed load, and notices when the app has gone -->
        <Timer id="frameTimer" repeat="true" duration="0.1" />
        
        <!-- Audio Player for live streaming -->
        <Audio id="audioPlayer" />
        
    </children>
</component>
